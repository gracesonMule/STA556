   "source": [
    "mkdir <directory_name> creates a directory with the specified name.\n",
    "\n",
    "rm -rf removes a directory and all files within.\n",
    "\n",
    "touch <file> will create a file with the specified name.\n",
    "\n",
    "cat <file> will output the contents of a file.\n",
    "\n",
    "pwd will print the working directory."
   ]
